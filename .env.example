# Client-side Cloudinary settings (safe to expose)
VITE_CLOUDINARY_CLOUD_NAME=dy1g9f3bj
VITE_CLOUDINARY_UPLOAD_PRESET=tuka_preset

# Server-only variables for /api/cloudinary/delete
CLOUDINARY_CLOUD_NAME=dy1g9f3bj
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

# Nodemailer SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tukasupport@gmail.com
SMTP_PASS=YOUR_GMAIL_APP_PASSWORD
SMTP_FROM="Tuka Clothing" <no-reply@tuka.co.in>

# Admin Email for Order Notifications
ADMIN_EMAIL=admin@tuka.com
VITE_ADMIN_EMAIL=admin@tuka.com

# Razorpay Payments
VITE_RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
