{
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/ithink/:action*",
      "destination": "/api/ithink?action=:action*"
    },
    {
      "source": "/api/delhivery/:action*",
      "destination": "/api/ithink?action=:action*"
    },
    {
      "source": "/api/orders/:action*",
      "destination": "/api/orders?action=:action*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
