{
  "rewrites": [
    {
      "source": "/api/ithink/:action*",
      "destination": "/api/ithink?action=:action*"
    },
    {
      "source": "/api/delhivery/:action*",
      "destination": "/api/ithink?action=:action*"
    },
    {
      "source": "/api/orders/:action*",
      "destination": "/api/orders?action=:action*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
